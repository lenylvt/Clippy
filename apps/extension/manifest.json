{
  "manifest_version": 3,
  "name": "Clippy",
  "description": "Clippe rapidement des passages YouTube",
  "version": "0.2.5",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost/*",
    "https://*.workers.dev/*"
  ],
  "action": {
    "default_title": "Clippy \u2014 r\u00e9glages",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/watch*"
      ],
      "js": [
        "lib/log.js",
        "lib/clip-constants.js",
        "lib/time.js",
        "lib/youtube.js",
        "lib/title.js",
        "lib/stages.js",
        "content/queue/clip-queue.js",
        "lib/status-badge.js",
        "content/editor/constants.js",
        "content/editor/filmstrip-cache.js",
        "content/editor/overlay-html.js",
        "content/editor/player-layout.js",
        "content/editor/filmstrip.js",
        "content/editor/playback.js",
        "content/editor/editor-clips.js",
        "content/editor/render.js",
        "content/editor/keys.js",
        "content/editor/timeline-clips.js",
        "content/editor/timeline.js",
        "content/editor/ClipEditor.js",
        "content/player-button.js",
        "content/clip-client.js",
        "content/content.js"
      ],
      "css": [
        "content/styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "open-clip-editor": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Ouvrir l'\u00e9diteur Clippy"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
