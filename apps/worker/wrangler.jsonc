{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clippy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Built by apps/install (`npm run install:build`) → public/install/
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/extension.zip",
      "/clips/*",
      "/health",
      "/",
      "/install"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CLIPS",
      "bucket_name": "clippy-clips"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clippy",
      "database_id": "1d9c8f39-e352-4b2f-b1d6-2dd6959e9501",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Must match OTP_FROM_EMAIL in src/constants.ts
      "allowed_sender_addresses": ["clippy@lenylvt.cc"]
    }
  ],
  // Secrets (wrangler secret put … --config wrangler.jsonc):
  //   CONTAINER_SECRET          — Worker↔container + /api/internal/*
  //   SESSION_SECRET            — clip URL HMAC (+ OTP fallback)
  //   OTP_PEPPER                — OTP HMAC pepper
  //   R2_ACCESS_KEY_ID          — optional; container→R2 presigned PUT
  //   R2_SECRET_ACCESS_KEY      — optional; container→R2 presigned PUT
  //   R2_ACCOUNT_ID             — optional; container→R2 presigned PUT
  //   EXPO_ACCESS_TOKEN         — optional; Expo push
  // Keep MAX_CONTAINER_SLOTS in src/constants.ts equal to containers.max_instances below.
  "vars": {
    "PUBLIC_ORIGIN": "https://clippy.runtimelayer.workers.dev",
    "PUBLIC_ORIGINS": "https://clippy.runtimelayer.workers.dev",
    "EXTENSION_ID": "mdlffepdgjacjmgjjhjigieingacjpfn",
    "EXTENSION_VERSION": "0.2.6",
    "R2_BUCKET": "clippy-clips"
  },
  "triggers": {
    // */5: queue pump + idle container cleanup via JobQueue DO
    // 0 * * *: expired/orphan clip purge (+ pump)
    "crons": ["*/5 * * * *", "0 * * * *"]
  },
  "containers": [
    {
      "class_name": "ClipContainer",
      "image": "./Dockerfile",
      // Keep in sync with MAX_CONTAINER_SLOTS in src/constants.ts
      "max_instances": 4,
      "instance_type": "standard-3",
      // Keep in sync with CONTAINER_ROLLOUT_GRACE_S (≥ worst-case job)
      "rollout_active_grace_period": 900
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ClipContainer",
        "name": "CLIP"
      },
      {
        "class_name": "JobQueue",
        "name": "JOB_QUEUE"
      }
    ]
  },
  // DO migration history is append-only — do not reorder or remove tags.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClipProcessor"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["ClipProcessor"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ClipContainer", "JobQueue"]
    }
  ]
}
