{
  "name": "clippy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/mobile"
  ],
  "scripts": {
    "test": "vp test",
    "build": "vp build",
    "worker:dev": "npm --prefix apps/worker run dev",
    "worker:deploy": "npm --prefix apps/worker run deploy",
    "worker:migrate": "npm --prefix apps/worker run migrate",
    "worker:migrate:local": "npm --prefix apps/worker run migrate:local",
    "worker:secret": "npm --prefix apps/worker run secret",
    "ext:pack": "cd apps/extension && zip -r ../../clippy-extension.zip . -x '*.test.js' -x '*/.DS_Store'",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:build:ios": "npm --prefix apps/mobile run ios:device",
    "bench:job": "node scripts/bench-job.mjs",
    "test:py": "cd apps/worker/container && python3 test_download.py"
  },
  "dependencies": {
    "@clippy/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
